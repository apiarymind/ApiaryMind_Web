# ============================================
# APIARYMIND WEB - CONFIGURATION
# ============================================
# Skopiuj ten plik do .env.local i uzupełnij wartości

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# EMAIL CONFIGURATION
# ============================================

# Email Driver: 'log' | 'smtp' | 'resend' | 'sendgrid'
# W trybie 'log' emaile są zapisywane w konsoli/pliku zamiast wysyłane
# Użyj 'log' podczas rozwoju, aby uniknąć błędów SMTP
EMAIL_DRIVER=log

# Email From Address
EMAIL_FROM=noreply@apiarymind.com
EMAIL_FROM_NAME=ApiaryMind

# Opcjonalnie: Zapisz emaile do pliku w trybie dev (ustaw na 'true')
# EMAIL_LOG_FILE=true

# ============================================
# SMTP CONFIGURATION (Zakomentowane - użyj gdy EMAIL_DRIVER=smtp)
# ============================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password

# ============================================
# RESEND CONFIGURATION (Zakomentowane - użyj gdy EMAIL_DRIVER=resend)
# ============================================
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# ============================================
# SENDGRID CONFIGURATION (Zakomentowane - użyj gdy EMAIL_DRIVER=sendgrid)
# ============================================
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# ============================================
# LEGACY FIREBASE (jeśli używane)
# ============================================
# NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id

# ============================================
# API BASE URL (jeśli używane)
# ============================================
# NEXT_PUBLIC_API_BASE_URL=http://localhost:1337/api







